# Banco
DATABASE_URL=postgres://user:pass@localhost:5432/portaria

# Segurança
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Chave de 32 bytes codificada em base64 (ex.: gerar com `openssl rand -base64 32`)
FIELD_ENCRYPTION_KEY=
# Mesmo valor configurado em app.bindex_pepper no Postgres
# (ALTER DATABASE seu_banco SET app.bindex_pepper = 'valor-secreto-forte';)
BINDEX_PEPPER=

# Fotos de people/vehicles (Supabase Storage — ver src/utils/supabaseStorage.js).
# Painel do Supabase: Settings > API. Usar a service_role key (NÃO a anon/public) —
# precisa bypassar RLS do Storage, já que a autorização é feita pela própria API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — nome do bucket. Default: "uploads". Criado sozinho (privado) na
# primeira vez que alguém envia uma foto, se ainda não existir.
SUPABASE_STORAGE_BUCKET=

# E-mail de recuperação de senha (SMTP — ver src/utils/email.js). OPCIONAL:
# sem host/usuário/senha configurados, o envio só loga um aviso no servidor,
# a API sobe normalmente do mesmo jeito (diferente do Supabase acima).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" só se usar porta 465 (SSL direto) — porta 587 (STARTTLS, mais comum) usa "false"/vazio.
SMTP_SECURE=
EMAIL_FROM=Portaria <no-reply@seudominio.com>
# Opcional — validade do link de recuperação. Default: 30m.
PASSWORD_RESET_EXPIRES_IN=

# App
# Em produção precisa ser EXATAMENTE "production" (sem variações como "prod")
# — é o que liga o `secure` do cookie de refresh (exige HTTPS). Um valor
# digitado errado passa despercebido sem essa palavra exata: config/env.js
# valida contra "development"/"test"/"production" e recusa subir com
# qualquer outra coisa, mas só pega o erro de digitação, não esquecer de
# setar (nesse caso o padrão já é "development", a falha mais segura).
NODE_ENV=development
PORT=3333
# Obrigatório com NODE_ENV=production (config/env.js recusa subir sem ele
# nesse caso) — precisa ser o domínio real do frontend, não o localhost do
# exemplo abaixo. Também usado pra montar o link de "esqueci minha senha"
# (auth.service.js#forgotPassword) — errado aqui, o e-mail de recuperação
# sai apontando pro lugar errado.
CORS_ORIGIN=http://localhost:5173

# Observabilidade (ver src/utils/logger.js e src/utils/sentry.js)
# Opcional — nível de log do pino. Default: "debug" fora de produção,
# "info" em produção. Valores aceitos: fatal, error, warn, info, debug,
# trace, silent (desliga o log por completo — usado em .env.test pra não
# poluir a saída do `npm test` com log de cada requisição).
LOG_LEVEL=
# Opcional — DSN do Sentry (Settings > Projects > seu projeto > Client Keys
# no painel do Sentry). Sem ele, rastreamento de erros fica desativado (a
# API sobe normalmente do mesmo jeito, diferente do Supabase acima).
SENTRY_DSN=

# Seed inicial (npm run seed) — cria a primeira empresa e o primeiro usuário admin.
# Só é lido pelo script de seed, nunca hardcoded no código. Preencher antes de rodar.
SEED_COMPANY_CORPORATE_NAME=
SEED_COMPANY_CNPJ=
SEED_ADMIN_NAME=
SEED_ADMIN_CPF=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional — bitmask de permissões (ver src/config/rules.js). Default: admin geral.
SEED_ADMIN_RULES=
