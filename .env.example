# Banco
DATABASE_URL=postgres://user:pass@localhost:5432/portaria

# Segurança
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Chave de 32 bytes codificada em base64 (ex.: gerar com `openssl rand -base64 32`)
FIELD_ENCRYPTION_KEY=
# Mesmo valor configurado em app.bindex_pepper no Postgres
# (ALTER DATABASE seu_banco SET app.bindex_pepper = 'valor-secreto-forte';)
BINDEX_PEPPER=

# Fotos de people/vehicles (Supabase Storage — ver src/utils/supabaseStorage.js).
# Painel do Supabase: Settings > API. Usar a service_role key (NÃO a anon/public) —
# precisa bypassar RLS do Storage, já que a autorização é feita pela própria API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — nome do bucket. Default: "uploads". Criado sozinho (privado) na
# primeira vez que alguém envia uma foto, se ainda não existir.
SUPABASE_STORAGE_BUCKET=

# App
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Seed inicial (npm run seed) — cria a primeira empresa e o primeiro usuário admin.
# Só é lido pelo script de seed, nunca hardcoded no código. Preencher antes de rodar.
SEED_COMPANY_CORPORATE_NAME=
SEED_COMPANY_CNPJ=
SEED_ADMIN_NAME=
SEED_ADMIN_CPF=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional — bitmask de permissões (ver src/config/rules.js). Default: admin geral.
SEED_ADMIN_RULES=
