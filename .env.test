# Valores fixos SÓ para a suíte de testes automatizados (backend/tests/) —
# não são segredos de produção, por isso este arquivo é commitado (ver
# exceção pra ele em .gitignore). Nunca reutilizar estes valores fora de
# teste.

# Banco de teste dedicado, no mesmo Postgres dev (container portaria-db) —
# criado/migrado automaticamente por tests/globalSetup.js.
# A API sob teste conecta com o papel app_runtime (não é dono das tabelas: o
# RLS vale, igual à produção); globalSetup, migrations e os helpers/factories
# dos testes usam o dono (MIGRATION_DATABASE_URL). A senha do app_runtime é
# definida pelo globalSetup.
DATABASE_URL=postgres://app_runtime:portaria_app_dev_pw@localhost:5432/portaria_test
MIGRATION_DATABASE_URL=postgres://portaria_admin:portaria_dev_pw@localhost:5432/portaria_test

JWT_ACCESS_SECRET=test-only-access-secret-nao-usar-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FIELD_ENCRYPTION_KEY=6egsnHgAeZcxqwOyLGfN8j0Bw1vhiG38NQZ9nEQO2QI=
BINDEX_PEPPER=test-only-bindex-pepper-nao-usar-em-producao

# Fake — só pra config/env.js não lançar erro na importação. Nenhum teste
# hoje exercita upload de foto, então nunca faz uma chamada de rede de
# verdade contra esses valores.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=test-only-fake-service-role-key

NODE_ENV=test
PORT=3334
CORS_ORIGIN=http://localhost:5173

# 'silent' de propósito: sem isso, o default fora de produção é 'debug', e
# cada teste de integração (supertest) dispara logs completos de
# requisição/resposta via pino-http, enterrando o resumo de pass/fail do
# Jest debaixo de centenas de linhas de JSON. Sobrescreva localmente
# (ex.: `LOG_LEVEL=debug npm test`) se precisar investigar um teste falhando.
LOG_LEVEL=silent
